# 生产环境变量模板（复制为 server/.env，填入真实值后勿提交 Git）
# 说明见 deploy/README.md

NODE_ENV=production
PORT=3002

# 生产必须使用 mysql，禁止 memory
ER_STORE=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=er_sasashui
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_DATABASE=er_sasashui

# openssl rand -base64 48
JWT_SECRET=replace-with-long-random-string

ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-admin-password

# 前端公开访问域名（与 VITE_SITE_URL 一致，无末尾斜杠）
CORS_ORIGIN=https://bs.code-market.online

# 可选：日志级别 info | warn | error（默认 info）
# LOG_LEVEL=info
